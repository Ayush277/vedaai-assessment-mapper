# ---------------------------------------------------------------------------
# VedaAI — environment configuration
# Copy to `.env.local` and fill in. Never commit real keys.
# ---------------------------------------------------------------------------

# Which vision/LLM provider drives extraction.
#   gemini    - Google Gemini (recommended; vision + embeddings on the free tier)
#   anthropic - Anthropic Claude (vision; no embedding API, falls back to lexical)
#   local     - Tesseract.js OCR only. No API key needed. Good on printed
#               question papers, weak on handwriting. Used automatically when
#               no key is configured.
AI_PROVIDER=gemini

# API key for the selected provider.
AI_API_KEY=

# Model override (optional). Defaults per provider:
#   gemini    -> gemini-flash-latest  (stable alias; tracks the current Flash model)
#   anthropic -> claude-sonnet-5
AI_MODEL=

# Embedding model used for semantic answer<->question similarity (optional).
# Gemini only. Defaults to gemini-embedding-001. When unavailable the mapper
# falls back to a local TF-IDF cosine similarity, which is deterministic and
# needs no network.
AI_EMBEDDING_MODEL=

# Enable the optional AI grading / feedback pass (adds one LLM call per run).
ENABLE_GRADING=true

# Upload limits.
MAX_UPLOAD_MB=10

# Max pages processed per document (protects against runaway API cost).
MAX_PAGES_PER_DOCUMENT=12

# Minimum milliseconds between provider requests. Provider calls are serialised
# and paced, which keeps free-tier per-minute quotas from tripping. The default
# of 3200ms is ~18 requests/minute, just under Gemini's 20/min free-tier limit.
# Set this to 0 on a paid tier to process as fast as the provider allows.
PROVIDER_MIN_INTERVAL_MS=3200
