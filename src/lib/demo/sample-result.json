        {
          "id": "a_4",
          "recognizedLabel": "5.",
          "normalizedRecognizedLabel": "5",
          "text": "An object stays at rest or keeps moving in a straight line unless an outside force acts on it. This is also called inertia.",
          "regions": [
            {
              "pageNumber": 2,
              "bbox": {
                "x": 0.05625,
